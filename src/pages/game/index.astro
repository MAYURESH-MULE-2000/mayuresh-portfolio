---
// REAL INDIA RPG - a standalone browser RPG.
// Deliberately not wrapped in the site Layout: the game wants the whole
// viewport, its own key handling and no particle canvas behind it.
const title = "Real India RPG"
const description =
  "An original top-down pixel-art RPG set in a fictional Indian town, where the encounters are everyday problems and the question is never simply whose problem is bigger."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} | Mayuresh Mule</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0a0f" />
    <link rel="icon" type="image/png" href="/images/avatars/avatar-1.png" />
    <link rel="stylesheet" href="/game/css/game.css" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <header class="rpg-topbar">
      <span class="rpg-topbar__title">REAL INDIA <span>RPG</span></span>
      <a href="/">&larr; back to mayuresh.com</a>
    </header>

    <main class="rpg-stage">
      <canvas id="game-canvas" width="720" height="480" aria-label="Real India RPG game screen"></canvas>
      <p class="rpg-status" id="game-loading">Loading&hellip;</p>
      <p id="game-error" hidden></p>
    </main>

    <!-- Keyboard legend: hidden on touch devices, which get the pad instead. -->
    <div class="rpg-legend">
      <span><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> / arrows move</span>
      <span><kbd>Space</kbd> talk &amp; confirm</span>
      <span><kbd>X</kbd> back</span>
      <span><kbd>M</kbd> menu</span>
      <span><kbd>J</kbd> journal</span>
    </div>

    <!-- On-screen controls. Every button maps to the same actions as the keys. -->
    <div class="rpg-controls" id="game-controls">
      <div class="rpg-dpad">
        <span class="rpg-dpad__spacer"></span>
        <button type="button" data-action="up" aria-label="Move up">&#9650;</button>
        <span class="rpg-dpad__spacer"></span>
        <button type="button" data-action="left" aria-label="Move left">&#9664;</button>
        <span class="rpg-dpad__spacer"></span>
        <button type="button" data-action="right" aria-label="Move right">&#9654;</button>
        <span class="rpg-dpad__spacer"></span>
        <button type="button" data-action="down" aria-label="Move down">&#9660;</button>
        <span class="rpg-dpad__spacer"></span>
      </div>

      <div></div>

      <div class="rpg-actions">
        <button type="button" data-action="journal" aria-label="Open journal">JOURNAL</button>
        <button type="button" data-action="confirm" aria-label="Confirm or talk">A</button>
        <button type="button" data-action="menu" aria-label="Open menu">MENU</button>
        <button type="button" data-action="cancel" aria-label="Back">B</button>
      </div>
    </div>

    <script is:inline type="module" src="/game/js/main.js"></script>
  </body>
</html>
