---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.vue";
---

<Layout
    title="Gym Workouts | Mayuresh Mule"
    description="My PPL workout routine - Push, Pull, Legs"
>
    <Header client:load />

    <main class="min-h-screen pt-20 pb-12 px-4">
        <div class="max-w-lg mx-auto">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1
                    class="text-3xl font-black text-gray-900 dark:text-white mb-2"
                >
                    My Workout Split
                </h1>
                <p class="text-gray-600 dark:text-gray-400">
                    Push Pull Legs - 6 days on, 1 day rest
                </p>
            </div>

            <!-- Schedule Overview -->
            <div class="bg-gray-100 dark:bg-gray-800/50 rounded-2xl p-4 mb-8">
                <h2
                    class="text-sm font-bold text-gray-500 dark:text-gray-400 mb-3 uppercase tracking-wider"
                >
                    Weekly Schedule
                </h2>
                <div class="grid grid-cols-7 gap-1 text-center text-sm">
                    <div class="py-2">
                        <div
                            class="text-gray-400 dark:text-gray-500 text-xs mb-1"
                        >
                            Mon
                        </div>
                        <div class="text-rose-500 font-bold">P</div>
                    </div>
                    <div class="py-2">
                        <div
                            class="text-gray-400 dark:text-gray-500 text-xs mb-1"
                        >
                            Tue
                        </div>
                        <div class="text-blue-500 font-bold">P</div>
                    </div>
                    <div class="py-2">
                        <div
                            class="text-gray-400 dark:text-gray-500 text-xs mb-1"
                        >
                            Wed
                        </div>
                        <div class="text-emerald-500 font-bold">L</div>
                    </div>
                    <div class="py-2">
                        <div
                            class="text-gray-400 dark:text-gray-500 text-xs mb-1"
                        >
                            Thu
                        </div>
                        <div class="text-rose-500 font-bold">P</div>
                    </div>
                    <div class="py-2">
                        <div
                            class="text-gray-400 dark:text-gray-500 text-xs mb-1"
                        >
                            Fri
                        </div>
                        <div class="text-blue-500 font-bold">P</div>
                    </div>
                    <div class="py-2">
                        <div
                            class="text-gray-400 dark:text-gray-500 text-xs mb-1"
                        >
                            Sat
                        </div>
                        <div class="text-emerald-500 font-bold">L</div>
                    </div>
                    <div class="py-2">
                        <div
                            class="text-gray-400 dark:text-gray-500 text-xs mb-1"
                        >
                            Sun
                        </div>
                        <div class="text-gray-400 font-bold">R</div>
                    </div>
                </div>
                <div
                    class="flex justify-center gap-4 mt-3 text-xs text-gray-500 dark:text-gray-400"
                >
                    <span
                        ><span class="text-rose-500 font-bold">P</span> Push</span
                    >
                    <span
                        ><span class="text-blue-500 font-bold">P</span> Pull</span
                    >
                    <span
                        ><span class="text-emerald-500 font-bold">L</span> Legs</span
                    >
                    <span
                        ><span class="text-gray-400 font-bold">R</span> Rest</span
                    >
                </div>
            </div>

            <!-- Workout Categories -->
            <div class="space-y-4">
                <!-- PUSH -->
                <a
                    href="/gym?category=push"
                    class="block group relative overflow-hidden rounded-3xl bg-gradient-to-br from-rose-500 to-orange-400 p-6 text-white transform hover:scale-[1.02] transition-transform"
                >
                    <div class="relative z-10">
                        <div class="text-4xl mb-2">💪</div>
                        <h2 class="text-2xl font-black mb-1">PUSH</h2>
                        <p class="text-white/80 text-sm">
                            Chest + Shoulders + Triceps
                        </p>
                        <p class="text-white/60 text-xs mt-2">
                            Mon / Thu • 8 exercises
                        </p>
                    </div>
                    <div
                        class="absolute -right-8 -bottom-8 w-32 h-32 bg-white/10 rounded-full group-hover:scale-150 transition-transform duration-500"
                    >
                    </div>
                </a>

                <!-- PULL -->
                <a
                    href="/gym?category=pull"
                    class="block group relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-500 to-cyan-400 p-6 text-white transform hover:scale-[1.02] transition-transform"
                >
                    <div class="relative z-10">
                        <div class="text-4xl mb-2">🔥</div>
                        <h2 class="text-2xl font-black mb-1">PULL</h2>
                        <p class="text-white/80 text-sm">Back + Biceps</p>
                        <p class="text-white/60 text-xs mt-2">
                            Tue / Fri • 8 exercises
                        </p>
                    </div>
                    <div
                        class="absolute -right-8 -bottom-8 w-32 h-32 bg-white/10 rounded-full group-hover:scale-150 transition-transform duration-500"
                    >
                    </div>
                </a>

                <!-- LEGS -->
                <a
                    href="/gym?category=legs"
                    class="block group relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-400 p-6 text-white transform hover:scale-[1.02] transition-transform"
                >
                    <div class="relative z-10">
                        <div class="text-4xl mb-2">🦵</div>
                        <h2 class="text-2xl font-black mb-1">LEGS</h2>
                        <p class="text-white/80 text-sm">
                            Quads + Hamstrings + Glutes + Calves
                        </p>
                        <p class="text-white/60 text-xs mt-2">
                            Wed / Sat • 8 exercises
                        </p>
                    </div>
                    <div
                        class="absolute -right-8 -bottom-8 w-32 h-32 bg-white/10 rounded-full group-hover:scale-150 transition-transform duration-500"
                    >
                    </div>
                </a>
            </div>

            <!-- Today's Workout CTA -->
            <div class="mt-8">
                <a
                    href="/gym"
                    class="block w-full py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-2xl text-center font-bold text-lg shadow-xl hover:shadow-2xl hover:scale-[1.02] transition-all"
                >
                    Start Today's Workout →
                </a>
            </div>
        </div>
    </main>
</Layout>
