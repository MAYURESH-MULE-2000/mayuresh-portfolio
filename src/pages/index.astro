---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.vue";
import SocialSidebar from "../components/SocialSidebar.vue";
import EmailSidebar from "../components/EmailSidebar.vue";
// import HeroDiagram from "../components/HeroDiagram.vue";
import HowIWork from "../components/HowIWork.vue";
import WinsStrip from "../components/WinsStrip.vue";
// import ImpactStories from "../components/ImpactStories.vue";
// import WhatImBuilding from "../components/WhatImBuilding.vue";
import WhatImWorkingOn from "../components/WhatImWorkingOn.vue";
import PM100Section from "../components/pm/PM100Section.vue";
import WhereImWorking from "../components/WhereImWorking.vue";
import LetsConnect from "../components/LetsConnect.vue";
import SpeedInsights from "@vercel/speed-insights/astro";
import { getCaseStudies, getProjects, getBlogs, getPMCases } from "../lib/content";

const caseStudies = await getCaseStudies();
const projects = await getProjects();
const blogs = await getBlogs();
const pmCases = await getPMCases();

const toResource = (type: string) => (item: any) => ({
  id: item.slug,
  type,
  title: item.title,
  label: item.category,
  slug: item.slug,
  status: item.status,
  description: item.metaDescription || "",
  thumbnail: item.heroImage || "",
  logo: item.logo || "",
  order: item.order,
  cardGradient: item.cardGradient,
  cardHoverGradient: item.cardHoverGradient,
  insights: item.insights,
});

const resources = [
  ...caseStudies.map(toResource("case-study")),
  ...projects.map(toResource("project")),
  ...blogs.map(toResource("blog")),
].sort((a, b) => a.order - b.order);

// Slugs temporarily hidden from the home page only (they stay live on /resources).
// Remove a slug from this list to bring it back on the home page.
const HIDDEN_ON_HOME = [
  "zomato-refund-trust", // Zomato refund & trust case study - hidden for now
];

const workingOnItems = resources.filter(
  (item) => !HIDDEN_ON_HOME.includes(item.slug),
);
---

<Layout
  title="Mayuresh Mule - UX Engineer & Product Builder"
  description="Portfolio of Mayuresh Mule – UX Engineer and Product Builder based in Mumbai, India."
>
  <Header client:load />
  <SocialSidebar client:load />
  <EmailSidebar client:load />

  <main class="px-16 md:px-32 py-20 pt-32">
    <div class="max-w-7xl mx-auto">

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 1 - HERO                        -->
      <!-- ═══════════════════════════════════════ -->
      <section id="hero" class="">
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-12 xl:gap-8 items-center">
          <div class="xl:col-span-7 max-w-6xl">
            <!-- xl:col-span-7 max-w-3xl -->
            <!-- Tagline -->
          <h1 class="text-3xl md:text-3xl font-bold leading-tight mb-6 tracking-tight">
            I close the gap between what stakeholders ask for and what engineers can build
            <span class="text-gray-400 dark:text-gray-500"> - through research, Figma, and Vue.js.</span>
          </h1>

          <!-- Sub-line -->
          <p class="text-lg md:text-xl text-gray-500 dark:text-gray-400 mb-8 transition-colors duration-300">
            UX Engineer · Product Builder · Mumbai, India
          </p>

          <!-- Metric Pills -->
          <div class="flex flex-wrap gap-3 mb-10">
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200/60 dark:border-gray-700/50 transition-colors duration-300">
              3+ years shipped
            </span>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200/60 dark:border-gray-700/50 transition-colors duration-300">
              4 hackathon wins
            </span>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200/60 dark:border-gray-700/50 transition-colors duration-300">
              1 live product (ShellScholars)
            </span>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4">
            <!-- <a
              href="#impact-stories"
              class="inline-flex items-center px-7 py-3 bg-primary-black dark:bg-primary-white text-primary-white dark:text-primary-black rounded-xl font-semibold hover:opacity-85 transition-all duration-300 text-base"
            >
              View my work
            </a> -->
            <a
              href="/journal"
              class="group inline-flex items-center gap-2 px-7 py-3 bg-primary-black dark:bg-primary-white text-primary-white dark:text-primary-black rounded-xl font-semibold transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-black/10 dark:hover:shadow-white/10 text-base"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] transition-transform duration-500 group-hover:-rotate-[8deg]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
              </svg>
              Read my journal
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-500"></span>
              </span>
            </a>
            <a
              href="/Mayuresh_Mule_26_7_26.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-1.5 px-7 py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-xl font-semibold hover:border-primary-black dark:hover:border-primary-white hover:text-primary-black dark:hover:text-primary-white transition-all duration-300 text-base"
            >
              Resume
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:scale-125 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
          </div>
        </div>
        <!-- <div class="xl:col-span-5 hidden xl:block">
          <HeroDiagram client:load />
        </div> -->
      </div>
    </section>

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 2 - HOW I WORK                  -->
      <!-- ═══════════════════════════════════════ -->
      <HowIWork client:visible />

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 3 - WINS STRIP                  -->
      <!-- ═══════════════════════════════════════ -->
      <WinsStrip client:visible />

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 4 - IMPACT STORIES              -->
      <!-- ═══════════════════════════════════════ -->
      <!-- <ImpactStories items={resources} client:visible /> -->

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 5 - WHAT I'M BUILDING (HIDDEN)  -->
      <!-- ═══════════════════════════════════════ -->
      <!-- <WhatImBuilding client:visible /> -->

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 6 - WHAT I'M WORKING ON         -->
      <!-- ═══════════════════════════════════════ -->
      <WhatImWorkingOn items={workingOnItems} client:visible />

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 7 - PM 100 CASES (UNTOUCHED)    -->
      <!-- ═══════════════════════════════════════ -->
      <PM100Section cases={pmCases} client:visible />

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 8 - WHERE I'M WORKING           -->
      <!-- ═══════════════════════════════════════ -->
      <WhereImWorking client:visible />

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 9 - LET'S CONNECT               -->
      <!-- ═══════════════════════════════════════ -->
      <LetsConnect client:visible />

      <SpeedInsights />
    </div>
  </main>
</Layout>

<script>
  // Smooth scroll for "View my work" CTA
  document.addEventListener('DOMContentLoaded', () => {
    const links = document.querySelectorAll('a[href^="#"]');
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  });
</script>
