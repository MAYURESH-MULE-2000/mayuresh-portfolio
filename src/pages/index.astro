---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.vue";
import SocialSidebar from "../components/SocialSidebar.vue";
import EmailSidebar from "../components/EmailSidebar.vue";
// import HeroDiagram from "../components/HeroDiagram.vue";
import HowIWork from "../components/HowIWork.vue";
import WinsStrip from "../components/WinsStrip.vue";
// import ImpactStories from "../components/ImpactStories.vue";
// import WhatImBuilding from "../components/WhatImBuilding.vue";
import WhatImWorkingOn from "../components/WhatImWorkingOn.vue";
import WhereImWorking from "../components/WhereImWorking.vue";
import LetsConnect from "../components/LetsConnect.vue";
import SpeedInsights from "@vercel/speed-insights/astro";
import { getCaseStudies } from "../lib/content";

const caseStudies = await getCaseStudies();

// Home page cards for the two independent products. The copy here is the
// engineering-facing framing; the case-study pages keep their own meta copy.
// WhatsApp Discover and the PM cases live on /resources.
const PRODUCT_CARDS: Record<
  string,
  { title: string; label: string; tags: string[]; description: string }
> = {
  shellscholars: {
    title: "ShellScholars - Portfolio registry platform (shellscholars.com)",
    label: "Independent Product",
    tags: ["Nuxt", "Supabase", "Audience-Aware Visibility", "Solo Build"],
    description:
      "One portfolio link that shows different content to different viewers - recruiters, friends, and strangers each see a different set of blocks. Built end to end on Nuxt and Supabase, from onboarding and profession-based templates to URL claiming.",
  },
  "unicorn-nexus": {
    title: "Unicorn Nexus - AI knowledge platform (unicorncraftstudios.com)",
    label: "Independent Product",
    tags: ["Multi-tenant SaaS", "RAG", "Embeddable Widget", "Solo Build"],
    description:
      "A solo-built, multi-tenant RAG platform. Its assistant embeds on any site with one script tag - a ~6 KB, zero-dependency widget. Built with automatic failover across LLM providers and workspace isolation via row-level security. Counts shown to users come from SQL aggregation, never from the model.",
  },
};

// Order the cards appear in on the home page.
const PRODUCT_ORDER = ["shellscholars", "unicorn-nexus"];

const independentProducts = PRODUCT_ORDER.flatMap((slug) => {
  const item: any = caseStudies.find((c: any) => c.slug === slug);
  if (!item) return [];
  const card = PRODUCT_CARDS[slug];
  return [
    {
      id: item.slug,
      type: "case-study",
      slug: item.slug,
      title: card.title,
      label: card.label,
      description: card.description,
      insights: card.tags,
      status: item.status,
      thumbnail: item.heroImage || "",
      logo: item.logo || "",
      cardGradient: item.cardGradient,
      cardHoverGradient: item.cardHoverGradient,
    },
  ];
});
---

<Layout
  title="Mayuresh Mule – Software Engineer (Frontend)"
  description="Portfolio of Mayuresh Mule, a Software Engineer in Mumbai building production frontends with Vue.js, Nuxt, Quasar, and React."
>
  <Header client:load />
  <SocialSidebar client:load />
  <EmailSidebar client:load />

  <main class="px-16 md:px-32 py-20 pt-32">
    <div class="max-w-7xl mx-auto">

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 1 - HERO                        -->
      <!-- ═══════════════════════════════════════ -->
      <section id="hero" class="">
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-12 xl:gap-8 items-center">
          <div class="xl:col-span-7 max-w-6xl">
            <!-- xl:col-span-7 max-w-3xl -->
            <!-- Tagline -->
          <h1 class="text-3xl md:text-3xl font-bold leading-tight mb-6 tracking-tight">
            I build frontends people actually finish using.
          </h1>

          <!-- Sub-line -->
          <p class="text-lg md:text-xl text-gray-500 dark:text-gray-400 mb-8 transition-colors duration-300">
            Software Engineer · Vue.js · Nuxt · Quasar · React · Mumbai, India
          </p>

          <!-- Metric Pills -->
          <div class="flex flex-wrap gap-3 mb-10">
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200/60 dark:border-gray-700/50 transition-colors duration-300">
              3+ years building production frontends
            </span>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200/60 dark:border-gray-700/50 transition-colors duration-300">
              25,000+ assessments delivered
            </span>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-200/60 dark:border-gray-700/50 transition-colors duration-300">
              2 live products
            </span>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="#where-im-working"
              class="group inline-flex items-center gap-2 px-7 py-3 bg-primary-black dark:bg-primary-white text-primary-white dark:text-primary-black rounded-xl font-semibold transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-black/10 dark:hover:shadow-white/10 text-base"
            >
              View my work
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-y-0.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            <a
              href="/Mayuresh_Mule_Resume.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-1.5 px-7 py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-xl font-semibold hover:border-primary-black dark:hover:border-primary-white hover:text-primary-black dark:hover:text-primary-white transition-all duration-300 text-base"
            >
              Resume
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:scale-125 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
          </div>
        </div>
        <!-- <div class="xl:col-span-5 hidden xl:block">
          <HeroDiagram client:load />
        </div> -->
      </div>
    </section>

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 2 - HOW I WORK                  -->
      <!-- ═══════════════════════════════════════ -->
      <HowIWork client:visible />

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 3 - WINS STRIP                  -->
      <!-- ═══════════════════════════════════════ -->
      <WinsStrip client:visible />

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 4 - IMPACT STORIES              -->
      <!-- ═══════════════════════════════════════ -->
      <!-- <ImpactStories items={resources} client:visible /> -->

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 5 - WHAT I'M BUILDING (HIDDEN)  -->
      <!-- ═══════════════════════════════════════ -->
      <!-- <WhatImBuilding client:visible /> -->

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 6 - INDEPENDENT PRODUCTS        -->
      <!-- ═══════════════════════════════════════ -->
      <WhatImWorkingOn items={independentProducts} client:visible />

      {/* PM cases + WhatsApp Discover now live on /resources. */}

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 8 - WHERE I'M WORKING           -->
      <!-- ═══════════════════════════════════════ -->
      <WhereImWorking client:visible />

      <!-- ═══════════════════════════════════════ -->
      <!-- SECTION 9 - LET'S CONNECT               -->
      <!-- ═══════════════════════════════════════ -->
      <LetsConnect client:visible />

      <SpeedInsights />
    </div>
  </main>
</Layout>

<script>
  // Smooth scroll for "View my work" CTA
  document.addEventListener('DOMContentLoaded', () => {
    const links = document.querySelectorAll('a[href^="#"]');
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  });
</script>
