        // ---- Initialization ----
        function initNewspaper() {
          var btn = document.getElementById("newspaper-toggle-btn");
          if (btn) {
            btn.addEventListener("click", toggleNewspaper);
          }

          // Check localStorage for persistence
          if (localStorage.getItem(STORAGE_KEY) === "true") {
            // Small delay to let Vue components mount first
            setTimeout(activateNewspaper, 100);
          }
        }

        // Run on DOM ready
